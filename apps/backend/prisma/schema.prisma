// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. USERS & AUTHENTICATION
// ============================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String // 'ADMIN' | 'TENTOR'
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tutor             Tutor?
  parent            Parent?
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([role])
}

// ============================================
// 2. TUTORS
// ============================================

model Tutor {
  id             String    @id @default(uuid())
  userId         String    @unique
  name           String
  phone          String?
  email          String?
  hireDate       DateTime?
  status         String    @default("ACTIVE") // 'ACTIVE' | 'INACTIVE' | 'ON_LEAVE'
  bankAccount    String?
  bankName       String?
  bankHolderName String?
  notes          String?
  title          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules      Schedule[]
  sessions       TeachingSession[]
  subjects       TutorSubject[]
  changeRequests ScheduleChangeRequest[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

model Program {
  id                  String            @id @default(uuid())
  code                String            @unique
  name                String
  learningModel       String
  usesQuota           Boolean           @default(true)
  defaultMeetingQuota Int               @default(24)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  classes             Class[]
  privatePackages     PrivatePackage[]
  schedules           Schedule[]
  sessions            TeachingSession[]
  honorRates          HonorRate[]
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// 3. STUDENTS
// ============================================

model Student {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  email         String?
  guardianName  String?
  guardianPhone String?
  // Administrative identity used by formal student letters. These remain
  // optional so existing student records remain valid after the migration.
  nis           String?
  school        String?
  schoolClass   String?
  status        String   @default("ACTIVE") // 'ACTIVE' | 'INACTIVE' | 'GRADUATED'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  packages    PrivatePackage[]
  sessions    TeachingSession[]
  schedules   Schedule[]
  enrollments ClassEnrollment[]
  parentLinks ParentStudent[]
  letters     StudentLetter[]

  @@index([status])
}

// Administrative documents only. These records are deliberately isolated
// from academic schedules, teaching sessions, attendance, packages and honor.
model StudentLetter {
  id                 String                  @id @default(uuid())
  studentId          String
  letterNumber       String
  letterDate         DateTime
  studentName        String
  studentNis         String
  studentSchool      String
  studentSchoolClass String
  programName        String
  startDate          DateTime
  endDate            DateTime
  verificationCode   String                  @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  student   Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedules StudentLetterSchedule[]

  @@index([studentId])
  @@index([letterNumber])
  @@index([letterDate])
}

model StudentLetterSchedule {
  id              String        @id @default(uuid())
  studentLetterId String
  meetingNumber   Int
  date            DateTime
  startTime       String
  endTime         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  studentLetter StudentLetter @relation(fields: [studentLetterId], references: [id], onDelete: Cascade)

  @@unique([studentLetterId, meetingNumber])
  @@index([studentLetterId])
}

// ============================================
// 3b. PARENTS (Orang Tua)
// ============================================

model Parent {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]

  @@index([userId])
}

// Join table: one Parent can be linked to multiple Student (siblings all
// enrolled at Pioneer Class), and — in principle — a Student could have more
// than one linked Parent account (e.g. both mother and father), so this is a
// genuine many-to-many, not a simple FK on Student.
model ParentStudent {
  id           String   @id @default(uuid())
  parentId     String
  studentId    String
  relationship String? // free text: 'Ayah' | 'Ibu' | 'Wali', etc.
  createdAt    DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

// ============================================
// 4. SUBJECTS (Mata Pelajaran)
// ============================================

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  sessions  TeachingSession[]
  schedules Schedule[]
  tutors    TutorSubject[]

  @@index([isActive])
}

model TutorSubject {
  id        String   @id @default(uuid())
  tutorId   String
  subjectId String
  createdAt DateTime @default(now())

  tutor   Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorId, subjectId])
  @@index([tutorId])
  @@index([subjectId])
}

// ============================================
// 5. CLASSES (Kelas Reguler)
// ============================================

model Class {
  id             String   @id @default(uuid())
  name           String   @unique
  level          String?
  programId      String?
  quotaTotal     Int      @default(24)
  quotaUsed      Int      @default(0)
  quotaRemaining Int      @default(24)
  status         String   @default("ACTIVE") // 'ACTIVE' | 'INACTIVE'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  program     Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  schedules   Schedule[]
  sessions    TeachingSession[]
  enrollments ClassEnrollment[]

  @@index([programId])
  @@index([status])
}

// ============================================
// 6. CLASS ENROLLMENTS
// ============================================

model ClassEnrollment {
  id             String   @id @default(uuid())
  classId        String
  studentId      String
  enrollmentDate DateTime @default(now())
  status         String   @default("ACTIVE") // 'ACTIVE' | 'INACTIVE' | 'GRADUATED'
  createdAt      DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

// ============================================
// 7. SCHEDULES (Jadwal Mengajar)
// ============================================

model Schedule {
  id          String    @id @default(uuid())
  tutorId     String?
  sessionType String // 'REGULAR' | 'PRIVATE'
  classId     String?
  studentId   String?
  subjectId   String?
  programId   String?
  dayOfWeek   Int // 0=Sunday, 6=Saturday
  startTime   DateTime
  endTime     DateTime
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("ACTIVE") // 'ACTIVE' | 'INACTIVE' | 'CANCELLED'
  mode        String    @default("OFFLINE") // 'ONLINE' | 'OFFLINE' — Tentor Jadwal mockup
  location    String? // free-text, e.g. "Cabang Sudirman"; only meaningful when mode=OFFLINE
  notes       String?
  isPattern   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tutor    Tutor?            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  class    Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  student  Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  subject  Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  program  Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  sessions TeachingSession[]

  @@index([tutorId])
  @@index([classId])
  @@index([studentId])
  @@index([status])
  @@index([programId])
}

// ============================================
// 8. TEACHING SESSIONS (CRITICAL TABLE)
// ============================================

model TeachingSession {
  id                    String    @id @default(uuid())
  scheduleId            String?
  patternOccurrenceDate DateTime?
  tutorId               String
  sessionType           String // 'REGULAR' | 'PRIVATE'
  sessionDate           DateTime
  startTime             DateTime?
  endTime               DateTime?
  classId               String?
  studentId             String?
  subjectId             String?
  programId             String?
  mode                  String    @default("OFFLINE")
  location              String?
  status                String    @default("SCHEDULED")
  honorRateSnapshot     Decimal? // IMMUTABLE - Snapshot at completion time
  material              String?
  teachingNotes         String?
  progressNotes         String?
  score                 Decimal?
  notes                 String?
  completedAt           DateTime?
  // Notifikasi Tentor (pengingat H-2 jam / H-1 jam): set once that reminder
  // has actually been sent so the sweep job (jobs/sessionReminders.ts) never
  // double-sends, even across restarts or a missed cron tick.
  reminder2hSentAt      DateTime?
  reminder1hSentAt      DateTime?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedBy             String?
  updatedAt             DateTime  @updatedAt

  schedule          Schedule?               @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  tutor             Tutor                   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  class             Class?                  @relation(fields: [classId], references: [id], onDelete: SetNull)
  student           Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  subject           Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  program           Program?                @relation(fields: [programId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  packageUsages     PrivatePackageUsage[]
  validations       SessionValidation[]
  changeRequests    ScheduleChangeRequest[]

  @@index([scheduleId, patternOccurrenceDate])
  @@index([tutorId])
  @@index([sessionDate])
  @@index([status])
  @@index([classId])
  @@index([studentId])
  @@index([programId])
}

model ScheduleChangeRequest {
  id                String    @id @default(uuid())
  teachingSessionId String
  tutorId           String
  proposedDate      DateTime
  proposedStartTime DateTime
  proposedEndTime   DateTime
  reason            String
  status            String    @default("PENDING")
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teachingSession TeachingSession @relation(fields: [teachingSessionId], references: [id], onDelete: Cascade)
  tutor           Tutor           @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([teachingSessionId, status])
  @@index([tutorId, status])
}

// ============================================
// 9. ATTENDANCE RECORDS (For Regular Classes)
// ============================================

model AttendanceRecord {
  id        String   @id @default(uuid())
  sessionId String
  studentId String
  status    String // 'PRESENT' | 'ABSENT' | 'LATE' | 'EXCUSED'
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session TeachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

// ============================================
// 10. PRIVATE PACKAGES (Paket Privat)
// ============================================

model PrivatePackage {
  id             String    @id @default(uuid())
  studentId      String
  programId      String?
  quotaTotal     Int       @default(24)
  quotaUsed      Int       @default(0)
  quotaRemaining Int       @default(24) // Calculated: quotaTotal - quotaUsed
  activationDate DateTime  @default(now())
  expiryDate     DateTime?
  status         String    @default("ACTIVE") // 'ACTIVE' | 'EXPIRED' | 'CANCELLED'
  packageName    String?
  price          Decimal?
  paymentDate    DateTime?
  paymentMethod  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program Program?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  usages  PrivatePackageUsage[]

  @@index([studentId])
  @@index([status])
  @@index([programId])
}

// ============================================
// 11. PRIVATE PACKAGE USAGES (Transaksi Kuota)
// ============================================

model PrivatePackageUsage {
  id           String   @id @default(uuid())
  packageId    String
  // Nullable: SESSION_COMPLETED entries are tied to a session, but
  // ADMIN_ADJUSTMENT entries (package activation, quota top-up) are not.
  sessionId    String?
  // Signed ledger: positive = quota consumed, negative = quota credited
  // (top-up, initial activation grant, cancellation refund).
  quantityUsed Int      @default(1)
  changeType   String // 'SESSION_COMPLETED' | 'ADMIN_ADJUSTMENT' | 'CANCELLATION_REFUND'
  changedBy    String?
  changedAt    DateTime @default(now())
  reason       String?

  package PrivatePackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  session TeachingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([sessionId])
}

// ============================================
// 12. HONOR RATES (Master Tarif)
// ============================================

model HonorRate {
  id            String    @id @default(uuid())
  sessionType   String // 'REGULAR' | 'PRIVATE'
  subjectId     String?
  programId     String?
  nominal       Decimal
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String    @default("ACTIVE") // 'ACTIVE' | 'INACTIVE'
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  program Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  history HonorRateHistory[]

  @@index([sessionType])
  @@index([programId])
  @@index([effectiveFrom])
  @@index([status])
}

// ============================================
// 13. HONOR RATE HISTORY
// ============================================

model HonorRateHistory {
  id         String   @id @default(uuid())
  rateId     String
  oldNominal Decimal?
  newNominal Decimal
  changedBy  String?
  changedAt  DateTime @default(now())
  reason     String?

  rate HonorRate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@index([rateId])
}

// ============================================
// 14. SESSION VALIDATIONS
// ============================================

model SessionValidation {
  id          String    @id @default(uuid())
  sessionId   String    @unique
  caseType    String // 'CANCELLATION_DAY_OF' | 'OVERDUE_COMPLETION' | 'MANUAL_CORRECTION' | 'DISPUTE'
  decision    String    @default("PENDING") // 'APPROVED' | 'REJECTED' | 'PENDING' | 'NEED_MORE_INFO'
  description String
  adminNotes  String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  decidedBy   String?
  decidedAt   DateTime?

  session TeachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([decision])
}

// ============================================
// 15. AUDIT LOGS (Jejak Perubahan)
// ============================================

model AuditLog {
  id        String   @id @default(uuid())
  tableName String
  recordId  String
  action    String // 'INSERT' | 'UPDATE' | 'DELETE'
  oldValues Json?
  newValues Json?
  changedBy String?
  changedAt DateTime @default(now())
  reason    String?

  @@index([tableName])
  @@index([recordId])
  @@index([changedAt])
}

// ============================================
// 16. NOTIFICATIONS (section J: "Notifikasi Tentor ketika ada
// perubahan jadwal atau kelas bentrok")
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("SCHEDULE_CHANGE") // 'SCHEDULE_CHANGE' | 'GENERAL'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// ============================================
// 17. WEB PUSH SUBSCRIPTIONS
// ============================================
// One row per browser/device a user has enabled push notifications on — a user
// logged in on both their phone and laptop gets two rows, both notified.

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
