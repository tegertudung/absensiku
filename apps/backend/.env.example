# Database Configuration
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/db_absensiku

# Server Configuration
NODE_ENV=development
PORT=3001

# JWT Configuration
JWT_SECRET=your-super-secret-key-here
JWT_EXPIRES_IN=7d

# CORS — comma-separated origin(s) allowed to call this API. Leave unset in
# local dev (defaults to allow-any). Set to your deployed frontend URL(s) in
# production, e.g. https://absensiku.vercel.app
FRONTEND_URL=http://localhost:3000

# Web Push (VAPID) — generate your own pair per environment:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pionerclass.com

# Application
APP_NAME=Absensiku
APP_VERSION=1.0.0

# Logging
LOG_LEVEL=debug
