{
  "name": "@absensiku/backend",
  "version": "1.0.0",
  "description": "Absensiku Backend API - Express + TypeScript",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_PATH=.env ts-node-dev --respawn -r dotenv/config src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc",
    "start": "cross-env DOTENV_CONFIG_PATH=.env node -r dotenv/config dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts || true",
    "format": "prettier --write 'src/**/*.ts' || true",
    "test:settings-phase1": "cross-env DOTENV_CONFIG_PATH=.env ts-node -r dotenv/config scripts/test-settings-phase1.ts"
  },
  "prisma": {
    "seed": "cross-env DOTENV_CONFIG_PATH=.env ts-node -r dotenv/config prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.3.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.53.0",
    "prettier": "^3.1.0",
    "prisma": "^5.3.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
